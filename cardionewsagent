"""
Agente news cardiologiche: PubMed -> DeepSeek (filtro/traduzione) -> Telegram
"""
import requests
import time
import xml.etree.ElementTree as ET

# --- CONFIGURAZIONE ---
DEEPSEEK_API_KEY = "IL_TUO_TOKEN_DEEPSEEK_QUI"
TELEGRAM_BOT_TOKEN = "IL_TUO_TOKEN_TELEGRAM_QUI"
TELEGRAM_CHAT_ID = "IL_TUO_USER_ID_TELEGRAM_QUI"
NCBI_API_KEY = ""  # opzionale: registrati su ncbi.nlm.nih.gov/account per salire da 3 a 10 richieste/sec

# Riviste monitorate, con ISSN reale (verificati su ISSN.org / Oxford Academic)
JOURNALS = {
    "European Heart Journal": "0195-668X",
    "EHJ Acute Cardiovascular Care": "2048-8734",
    "European Journal of Preventive Cardiology": "2047-4873",
    "European Journal of Heart Failure": "1388-9842",
    "Europace": "1099-5129",
    "EHJ Cardiovascular Imaging": "2047-2412",
    "EHJ Cardiovascular Pharmacotherapy": "2055-6845",
    "Circulation": "0009-7322",
    "JACC": "0735-1097",
}

PUBMED_ESEARCH = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi"
PUBMED_EFETCH = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi"


def _base_params(extra):
    p = dict(extra)
    if NCBI_API_KEY:
        p["api_key"] = NCBI_API_KEY
    return p


def search_recent_ids(issn, max_results=3):
    """Restituisce gli ID PubMed più recenti (ultimi 3 giorni) per una rivista via ISSN."""
    params = _base_params({
        "db": "pubmed",
        "term": f'"{issn}"[Journal] AND ("last 3 days"[PDat])',
        "retmax": max_results,
        "sort": "most recent",
        "retmode": "json",
    })
    r = requests.get(PUBMED_ESEARCH, params=params, timeout=20).json()
    return r.get("esearchresult", {}).get("idlist", [])


def fetch_articles_xml(pmids):
    """Un'unica chiamata efetch in XML per tutti gli ID: parsing pulito di titolo e abstract."""
    if not pmids:
        return []
    params = _base_params({
        "db": "pubmed",
        "id": ",".join(pmids),
        "rettype": "abstract",
        "retmode": "xml",
    })
    resp = requests.get(PUBMED_EFETCH, params=params, timeout=20)
    root = ET.fromstring(resp.content)

    articles = []
    for art in root.findall(".//PubmedArticle"):
        pmid = art.findtext(".//PMID", default="")
        title = art.findtext(".//ArticleTitle", default="").strip()

        # L'abstract può avere più sezioni (Background/Methods/Results/Conclusions):
        # le uniamo in un unico testo pulito, senza tag o metadati extra.
        abstract_parts = []
        for ab_text in art.findall(".//Abstract/AbstractText"):
            label = ab_text.get("Label")
            text = "".join(ab_text.itertext()).strip()
            if not text:
                continue
            abstract_parts.append(f"{label}: {text}" if label else text)
        abstract = " ".join(abstract_parts).strip()

        articles.append({
            "pmid": pmid,
            "title": title,
            "abstract": abstract,
            "link": f"https://pubmed.ncbi.nlm.nih.gov/{pmid}/",
        })
    return articles


def analyze_with_deepseek(title, abstract, source):
    """Interroga DeepSeek per tradurre, filtrare e riassumere l'articolo."""
    url = "https://api.deepseek.com/chat/completions"
    headers = {
        "Authorization": f"Bearer {DEEPSEEK_API_KEY}",
        "Content-Type": "application/json",
    }

    prompt = f"""
Act as a clinical cardiologist and intensive care specialist. Analyze this publication:
Source: {source}
Original Title: {title}
Abstract: {abstract[:2000]}

If the article is NOT a relevant clinical trial, a new guideline, or a crucial clinical finding,
reply ONLY with the word: IGNORE.

If relevant, provide text in ENGLISH formatted exactly like this:
❤️ **[TITLE]**
🏛️ *Source:* {source}
🎯 *Clinical Relevance:* (2 lines)
📝 *Summary of Findings:* (max 4 lines)
"""

    data = {
        "model": "deepseek-chat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.2,
    }

    try:
        response = requests.post(url, json=data, headers=headers, timeout=30).json()
        return response["choices"][0]["message"]["content"].strip()
    except Exception as e:
        print(f"Errore DeepSeek: {e}")
        return "IGNORA"


def send_to_telegram(message, link):
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": f"{message}\n\n🔗 [Leggi su PubMed]({link})",
        "parse_mode": "Markdown",
    }
    requests.post(url, json=payload, timeout=20)


def main():
    print("Avvio monitoraggio news in cardiologia (fonte: PubMed)...")
    for source_name, issn in JOURNALS.items():
        print(f"Controllo: {source_name}")
        ids = search_recent_ids(issn)
        articles = fetch_articles_xml(ids)  # 1 sola chiamata per rivista, non 1 per articolo
        for art in articles:
            if not art["abstract"]:
                continue  # niente abstract (es. editoriali brevi) -> saltiamo, non analizzabile
            analysis = analyze_with_deepseek(art["title"], art["abstract"], source_name)
            if "IGNORA" not in analysis:
                send_to_telegram(analysis, art["link"])
                print(f"Notifica inviata: {art['title']}")
        time.sleep(0.4 if NCBI_API_KEY else 1)  # rate limit NCBI: 10/sec con api_key, 3/sec senza

    print("Monitoraggio completato.")


if __name__ == "__main__":
    main()
