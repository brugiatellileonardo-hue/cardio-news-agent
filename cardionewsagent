"""
Agente news cardiologiche: PubMed -> DeepSeek (filtro) -> Telegram
Versione ultra-stabile contro i crash (Exit Code 2)
"""
import os
import time
import xml.etree.ElementTree as ET
import requests

# --- CONFIGURAZIONE SICURA (Lettura da GitHub Secrets) ---
DEEPSEEK_API_KEY = os.environ.get("DEEPSEEK_API_KEY")
TELEGRAM_BOT_TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN")
TELEGRAM_CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID")
NCBI_API_KEY = os.environ.get("NCBI_API_KEY", "")

# Database riviste aggiornato con ISSN ufficiali e fonti richieste
JOURNALS = {
    "Giornale Italiano di Cardiologia": "1827-6806",
    "European Heart Journal": "0195-668X",
    "EHJ Acute Cardiovascular Care": "2048-8734",
    "European Journal of Preventive Cardiology": "2047-4873",
    "European Journal of Heart Failure": "1388-9842",
    "Europace": "1099-5129",
    "EHJ Cardiovascular Imaging": "2047-2412",
    "Circulation": "0009-7322",
    "JACC": "0735-1097",
}

PUBMED_ESEARCH = "https://nih.gov"
PUBMED_EFETCH = "https://nih.gov"

def _base_params(extra):
    p = dict(extra)
    if NCBI_API_KEY:
        p["api_key"] = NCBI_API_KEY
    return p

def search_recent_ids(source_name, identifier, max_results=3):
    if source_name == "Critical Care Reviews":
        term = '("Critical Care Reviews"[Journal] OR "Critical Care"[Journal]) AND ("last 3 days"[PDat]) AND (trial[Title/Abstract] OR guideline[Title/Abstract])'
    else:
        term = f'"{identifier}"[Journal] AND ("last 3 days"[PDat])'

    params = _base_params({
        "db": "pubmed",
        "term": term,
        "retmax": max_results,
        "sort": "most recent",
        "retmode": "json",
    })
    try:
        r = requests.get(PUBMED_ESEARCH, params=params, timeout=20)
        r.raise_for_status()
        return r.json().get("esearchresult", {}).get("idlist", [])
    except Exception as e:
        print(f"Avviso: Errore ricerca PubMed per {source_name}: {e}")
        return []

def fetch_articles_xml(pmids):
    if not pmids:
        return []
    params = _base_params({
        "db": "pubmed",
        "id": ",".join(pmids),
        "rettype": "abstract",
        "retmode": "xml",
    })
    try:
        resp = requests.get(PUBMED_EFETCH, params=params, timeout=20)
        resp.raise_for_status()
        root = ET.fromstring(resp.content)
    except Exception as e:
        print(f"Avviso: Errore recupero XML PubMed: {e}")
        return []

    articles = []
    for art in root.findall(".//PubmedArticle"):
        pmid = art.findtext(".//PMID", default="")
        title = art.findtext(".//ArticleTitle", default="").strip()

        abstract_parts = []
        for ab_text in art.findall(".//Abstract/AbstractText"):
            label = ab_text.get("Label")
            text = "".join(ab_text.itertext()).strip()
            if not text:
                continue
            abstract_parts.append(f"{label}: {text}" if label else text)
        abstract = " ".join(abstract_parts).strip()

        articles.append({
            "pmid": pmid,
            "title": title,
            "abstract": abstract,
            "link": f"https://nih.gov{pmid}/",
        })
    return articles

def analyze_with_deepseek(title, abstract, source):
    url = "https://deepseek.com"
    headers = {
        "Authorization": f"Bearer {DEEPSEEK_API_KEY}",
        "Content-Type": "application/json",
    }

    prompt = f"""
Act as a clinical cardiologist and intensive care specialist. Point out updates for physicians.
Analyze this publication:
Source: {source}
Original Title: {title}
Abstract: {abstract[:2500]}

If the article is NOT a relevant clinical trial, a new guideline, an important meta-analysis, or a crucial clinical finding,
reply ONLY with the word: IGNORE.

If relevant, provide text in ENGLISH formatted exactly like this:
❤️ **[TITLE IN ENGLISH]**
🏛️ *Source:* {source}
🎯 *Clinical Relevance:* (2 lines max explaining why a physician should care)
📝 *Summary of Findings:* (max 4 lines pinpointing endpoints and results)
"""

    data = {
        "model": "deepseek-chat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0.1,
    }

    try:
        response = requests.post(url, json=data, headers=headers, timeout=30)
        res_json = response.json()
        if "choices" in res_json:
            return res_json["choices"][0]["message"]["content"].strip()
        else:
            print(f"Errore risposta DeepSeek (Verifica credito o API Key): {res_json}")
            return "IGNORE"
    except Exception as e:
        print(f"Errore di rete DeepSeek: {e}")
        return "IGNORE"

def send_to_telegram(message, link):
    url = f"https://telegram.org{TELEGRAM_BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": TELEGRAM_CHAT_ID,
        "text": f"{message}\n\n🔗 [Link to PubMed]({link})",
        "parse_mode": "Markdown",
    }
    try:
        requests.post(url, json=payload, timeout=20)
    except Exception as e:
        print(f"Errore invio Telegram: {e}")

def main():
    print("Avvio monitoraggio avanzato news (PubMed + DeepSeek)...")
    
    all_sources = dict(JOURNALS)
    all_sources["Critical Care Reviews"] = "CC_REVIEW_SPECIAL"

    for source_name, identifier in all_sources.items():
        print(f"Controllo fonte: {source_name}")
        ids = search_recent_ids(source_name, identifier)
        articles = fetch_articles_xml(ids)

        for art in articles:
            if not art["abstract"]:
                continue

            analysis = analyze_with_deepseek(art["title"], art["abstract"], source_name)

            if "IGNORE" not in analysis:
                send_to_telegram(analysis, art["link"])
                print(f"Notifica inviata con successo per: {art['title']}")

        time.sleep(0.4 if NCBI_API_KEY else 1.2)

    print("Monitoraggio completato con successo.")

if __name__ == "__main__":
    main()
